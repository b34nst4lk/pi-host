{
	"name": "pi-host",
	"private": true,
	"type": "module",
	"description": "Persistent durable-agent host: harness + Matrix steer surface, built on @earendil-works/pi-durable",
	"scripts": {
		"daemon": "tsx src/daemon.ts",
		"test": "vitest --run",
		"typecheck": "tsc --noEmit",
		"fsize": "node scripts/fsize.mjs",
		"wall:test": "cd wall && gleam test",
		"gates": "npm run typecheck && npm test && npm run fsize && npm run wall:test"
	},
	"dependencies": {
		"@earendil-works/chord": "file:vendor/earendil-works-chord-1.3.0.tgz",
		"@earendil-works/pi-ai": "file:vendor/earendil-works-pi-ai-1.3.0.tgz",
		"@earendil-works/pi-codemode": "file:vendor/earendil-works-pi-codemode-1.3.0.tgz",
		"@earendil-works/pi-durable": "file:vendor/earendil-works-pi-durable-1.3.0.tgz",
		"@earendil-works/pi-telemetry": "file:vendor/earendil-works-pi-telemetry-1.3.0.tgz",
		"tsx": "^4.23.15"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"typescript": "^5.9.3",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": ">=22.6"
	}
}
